# Copy to .env. Every value has a default; unset DATABASE_URL starts a local PostgreSQL in ./.data/pg.
PORT=3100
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# REDIS_URL=rediss://default:password@host:6379
SEED_DEMO=false

HOLD_TTL_SECONDS=600
PAY_WINDOW_SECONDS=300
MAX_TICKETS_PER_BUYER=6
CANCEL_WINDOW_HOURS=24

# Demo login shows the one-time code in the response. Turn off for anything real.
DEMO_OTP=true
RATE_LIMIT=true
GATE_ENABLED=true
CACHE_TTL_MS=1000

# Required (and must not start with "dev-") when NODE_ENV=production
ADMIN_API_KEY=dev-admin-key
WEBHOOK_SECRET=dev-webhook-secret
PASS_SECRET=dev-pass-secret
