{
  "name": "atomicpass-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "tsx server/src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && npm --prefix web run build",
    "web:build": "npm --prefix web install && npm --prefix web run build",
    "seed": "tsx server/src/seed-cli.ts",
    "test": "vitest run",
    "load": "tsx scripts/load.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "embedded-postgres": "^17.5.0-beta.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
