# AtomicPass settings. Copy this file to .env to change a value.
# Every setting has a default, so the app also runs with no .env at all.
# Time limits are in seconds unless the name ends in _MS (milliseconds).
# Placeholders only: never put real secrets in this file.

# HTTP port
PORT=3000
# SQLite database file (the folder is created on first start)
DATABASE_PATH=./data/atomicpass.db
# How long a hold keeps its seats before they are freed (the demo uses 2)
HOLD_TTL_SECONDS=600
# How often the background sweeper expires old holds, in ms (0 = off; the next reservation still frees seats)
HOLD_SWEEP_INTERVAL_MS=5000
# Default max_per_order for new tiers
DEFAULT_MAX_PER_ORDER=6
# Tickets one buyer (normalised email) may hold or own per event (0 = no cap)
MAX_TICKETS_PER_BUYER=4
# How often the waiting room admits the next entries, in ms (0 = off; tests tick by hand)
QUEUE_TICK_MS=2000
# Waiting-room entries admitted per tick
QUEUE_ADMIT_PER_TICK=25
# Most unused admissions allowed at once
QUEUE_MAX_ADMITTED=100
# How long one admission stays valid
QUEUE_ADMIT_TTL_SECONDS=120
# Value of the x-admin-key header for /api/admin/* (placeholder: change it)
ADMIN_API_KEY=change-me-admin
# Value of the x-gate-key header for /api/checkin (placeholder: change it)
GATE_API_KEY=change-me-gate
# Payment provider; only "mock" exists (no network, no keys)
PAYMENT_MODE=mock
# Currency label returned in responses
CURRENCY=INR
# Log level: fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
